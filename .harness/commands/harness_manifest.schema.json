{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Broda/agent_dev_template/.harness/commands/harness_manifest.schema.json",
  "title": "Project Harness Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "harnessVersion",
    "templateRepository",
    "sourceCommit",
    "sourceCommitType",
    "sourceWorktreeDirty",
    "compatibility",
    "supportedModes",
    "stableWrappers",
    "posixExecutablePaths",
    "artifactInventory",
    "artifactInventoryExclusions",
    "artifactInventorySnapshotPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "harnessVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "templateRepository": {
      "type": "string",
      "minLength": 1
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 1
    },
    "sourceCommitType": {
      "type": "string",
      "enum": ["template", "git", "unknown"]
    },
    "sourceWorktreeDirty": {
      "type": "boolean"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrapperRuntimeVersion",
        "capabilityVersion",
        "stateSchemaVersion",
        "stateSchemaPath"
      ],
      "properties": {
        "wrapperRuntimeVersion": {"type": "integer", "minimum": 1},
        "capabilityVersion": {"type": "integer", "minimum": 1},
        "stateSchemaVersion": {"type": "integer", "minimum": 1},
        "stateSchemaPath": {"type": "string", "minLength": 1}
      }
    },
    "supportedModes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["brainstorming", "development"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "stableWrappers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "backendCommand"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "backendCommand": {"type": "string", "minLength": 1}
        }
      },
      "minItems": 1
    },
    "posixExecutablePaths": {
      "$ref": "#/$defs/pathList"
    },
    "artifactInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harnessOwned", "projectOwned", "mixedGenerated", "archival"],
      "properties": {
        "harnessOwned": {"$ref": "#/$defs/pathList"},
        "projectOwned": {"$ref": "#/$defs/pathList"},
        "mixedGenerated": {"$ref": "#/$defs/pathList"},
        "archival": {"$ref": "#/$defs/pathList"}
      }
    },
    "artifactInventoryExclusions": {
      "$ref": "#/$defs/pathList"
    },
    "artifactInventorySnapshotPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "snapshotGeneration", "rationale", "broadEntries"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["keep-broad-directory-entries"]
        },
        "snapshotGeneration": {
          "type": "string",
          "enum": ["deferred"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "broadEntries": {
          "$ref": "#/$defs/pathList"
        }
      }
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
