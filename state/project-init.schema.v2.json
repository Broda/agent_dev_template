{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Broda/agent_dev_template/state/project-init.schema.v2.json",
  "title": "Project Harness Canonical State",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "status",
    "finalizedAt",
    "ideaId",
    "projectName",
    "owner",
    "purpose",
    "projectType",
    "techStack",
    "persistence",
    "authentication",
    "determinism",
    "packaging",
    "constraints",
    "commands",
    "product",
    "governance",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "status": { "type": "string", "enum": ["draft", "finalized"] },
    "finalizedAt": { "type": "string" },
    "ideaId": { "type": "string" },
    "projectName": { "type": "string" },
    "owner": { "type": "string" },
    "purpose": { "type": "string" },
    "projectType": { "type": "string" },
    "techStack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "runtime", "framework", "packageTool"],
      "properties": {
        "language": { "type": "string" },
        "runtime": { "type": "string" },
        "framework": { "type": "string" },
        "packageTool": { "type": "string" }
      }
    },
    "persistence": { "type": "string" },
    "authentication": { "type": "string" },
    "determinism": { "type": "string" },
    "packaging": { "type": "string" },
    "constraints": { "type": "string" },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "run", "test"],
      "properties": {
        "build": { "type": "string" },
        "run": { "type": "string" },
        "test": { "type": "string" }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ciPolicy": { "type": "string" },
        "wiki": { "type": "object" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problemStatement",
        "targetUsers",
        "whyNow",
        "expectedValue",
        "solutionSummary",
        "mvpScope",
        "outOfScope",
        "assumptions",
        "nonGoals"
      ],
      "properties": {
        "problemStatement": { "type": "string" },
        "targetUsers": { "type": "string" },
        "whyNow": { "type": "string" },
        "expectedValue": { "type": "string" },
        "solutionSummary": { "type": "string" },
        "mvpScope": { "type": "string" },
        "outOfScope": { "type": "string" },
        "assumptions": { "type": "string" },
        "nonGoals": { "type": "string" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyDecisions",
        "topRisks",
        "mitigationPlans",
        "contingencies",
        "remainingAcceptedRisks",
        "latestReviewOutcome",
        "latestReviewSession"
      ],
      "properties": {
        "keyDecisions": { "type": "string" },
        "topRisks": { "type": "string" },
        "mitigationPlans": { "type": "string" },
        "contingencies": { "type": "string" },
        "remainingAcceptedRisks": { "type": "string" },
        "latestReviewOutcome": { "type": "string" },
        "latestReviewSession": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ideaFiles",
        "sessionFiles",
        "noteReferences",
        "summaryExport",
        "finalizationSession",
        "adrReferences"
      ],
      "properties": {
        "ideaFiles": { "type": "array", "items": { "type": "string" } },
        "sessionFiles": { "type": "array", "items": { "type": "string" } },
        "noteReferences": { "type": "string" },
        "summaryExport": { "type": "string" },
        "finalizationSession": { "type": "string" },
        "adrReferences": { "type": "array", "items": { "type": "string" } }
      }
    },
    "implementation": { "type": "object" },
    "mvpContract": { "type": "object" },
    "brainstormingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "decisions", "risks", "relatedNotes"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "level", "situation", "constraints", "chosenOption", "rationale", "source"],
            "properties": {
              "id": { "type": "string" },
              "level": { "type": "string" },
              "situation": { "type": "string" },
              "constraints": { "type": "string" },
              "chosenOption": { "type": "string" },
              "rationale": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "probability", "impact", "mitigation", "contingency", "source"],
            "properties": {
              "id": { "type": "string" },
              "statement": { "type": "string" },
              "probability": { "type": "string" },
              "impact": { "type": "string" },
              "mitigation": { "type": "string" },
              "contingency": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        },
        "relatedNotes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "path", "sourceContext", "tags"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "path": { "type": "string" },
              "sourceContext": { "type": "string" },
              "tags": { "type": "string" }
            }
          }
        }
      }
    },
    "finalizedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "capabilities",
        "ownershipBoundaries",
        "invariants",
        "domainConcepts",
        "domainModel",
        "dataModel",
        "publicContracts",
        "versionDomains",
        "milestones",
        "deferredScope"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interfaces", "surfaces", "authentication"],
          "properties": {
            "interfaces": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["cli", "api", "web_ui", "admin_ui", "worker", "library"]
              }
            },
            "surfaces": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "cli_commands",
                  "http_api",
                  "browser_ui",
                  "admin_ui",
                  "data_pipeline",
                  "local_files",
                  "sqlite",
                  "database",
                  "library_api"
                ]
              }
            },
            "authentication": { "type": "string", "enum": ["none", "local", "external", "unknown"] }
          }
        },
        "ownershipBoundaries": { "type": "array", "items": { "type": "string" } },
        "invariants": { "type": "array", "items": { "type": "string" } },
        "domainConcepts": { "type": "array", "items": { "type": "string" } },
        "domainModel": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "dataModel": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "publicContracts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "contract": { "type": "string" },
              "surface": {
                "type": "string",
                "enum": ["cli_commands", "http_api", "browser_ui", "admin_ui", "data_pipeline", "local_files", "sqlite", "database", "library_api"]
              },
              "version": { "type": "string" }
            }
          }
        },
        "versionDomains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain"],
            "properties": {
              "domain": { "type": "string" },
              "version": { "type": "string" },
              "compatibility": { "type": "string" }
            }
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "tasks", "gates"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "goal": { "type": "string" },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["area", "text"],
                  "properties": {
                    "area": { "type": "string" },
                    "text": { "type": "string" }
                  }
                }
              },
              "gates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "evidence"],
                  "properties": {
                    "name": { "type": "string" },
                    "evidence": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "deferredScope": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "x-variantRequirements": {
    "draft": {
      "status": "draft",
      "nonEmpty": []
    },
    "finalized": {
      "status": "finalized",
      "nonEmpty": [
        "ideaId",
        "projectType",
        "product.problemStatement",
        "product.solutionSummary",
        "governance.topRisks",
        "artifacts.sessionFiles",
        "artifacts.adrReferences"
      ],
      "existingArtifactReferences": [
        "artifacts.summaryExport",
        "artifacts.adrReferences"
      ]
    }
  }
}
