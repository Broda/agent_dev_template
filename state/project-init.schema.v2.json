{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Broda/agent_dev_template/state/project-init.schema.v2.json",
  "title": "Project Harness Canonical State",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "status",
    "finalizedAt",
    "ideaId",
    "projectName",
    "owner",
    "purpose",
    "projectType",
    "techStack",
    "persistence",
    "authentication",
    "determinism",
    "packaging",
    "constraints",
    "commands",
    "product",
    "governance",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "status": { "type": "string", "enum": ["draft", "finalized"] },
    "finalizedAt": { "type": "string" },
    "ideaId": { "type": "string" },
    "projectName": { "type": "string" },
    "owner": { "type": "string" },
    "purpose": { "type": "string" },
    "projectType": { "type": "string" },
    "techStack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "runtime", "framework", "packageTool"],
      "properties": {
        "language": { "type": "string" },
        "runtime": { "type": "string" },
        "framework": { "type": "string" },
        "packageTool": { "type": "string" }
      }
    },
    "persistence": { "type": "string" },
    "authentication": { "type": "string" },
    "determinism": { "type": "string" },
    "packaging": { "type": "string" },
    "constraints": { "type": "string" },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "run", "test"],
      "properties": {
        "build": { "type": "string" },
        "run": { "type": "string" },
        "test": { "type": "string" }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ciPolicy": { "type": "string" },
        "wiki": { "type": "object" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problemStatement",
        "targetUsers",
        "whyNow",
        "expectedValue",
        "solutionSummary",
        "mvpScope",
        "outOfScope",
        "assumptions",
        "nonGoals"
      ],
      "properties": {
        "problemStatement": { "type": "string" },
        "targetUsers": { "type": "string" },
        "whyNow": { "type": "string" },
        "expectedValue": { "type": "string" },
        "solutionSummary": { "type": "string" },
        "mvpScope": { "type": "string" },
        "outOfScope": { "type": "string" },
        "assumptions": { "type": "string" },
        "nonGoals": { "type": "string" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyDecisions",
        "topRisks",
        "mitigationPlans",
        "contingencies",
        "remainingAcceptedRisks",
        "latestReviewOutcome",
        "latestReviewSession"
      ],
      "properties": {
        "keyDecisions": { "type": "string" },
        "topRisks": { "type": "string" },
        "mitigationPlans": { "type": "string" },
        "contingencies": { "type": "string" },
        "remainingAcceptedRisks": { "type": "string" },
        "latestReviewOutcome": { "type": "string" },
        "latestReviewSession": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ideaFiles",
        "sessionFiles",
        "noteReferences",
        "summaryExport",
        "finalizationSession",
        "adrReferences"
      ],
      "properties": {
        "ideaFiles": { "type": "array", "items": { "type": "string" } },
        "sessionFiles": { "type": "array", "items": { "type": "string" } },
        "noteReferences": { "type": "string" },
        "summaryExport": { "type": "string" },
        "finalizationSession": { "type": "string" },
        "adrReferences": { "type": "array", "items": { "type": "string" } }
      }
    },
    "implementation": { "type": "object" },
    "mvpContract": { "type": "object" },
    "finalizedContract": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schemaVersion": { "type": "integer" },
        "capabilities": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "interfaces": { "type": "array", "items": { "type": "string" } },
            "surfaces": { "type": "array", "items": { "type": "string" } },
            "authentication": { "type": "string" }
          }
        },
        "ownershipBoundaries": { "type": "array", "items": { "type": "string" } },
        "invariants": { "type": "array", "items": { "type": "string" } },
        "domainConcepts": { "type": "array", "items": { "type": "string" } },
        "domainModel": { "type": "array" },
        "dataModel": { "type": "array" },
        "publicContracts": { "type": "array" },
        "versionDomains": { "type": "array" },
        "milestones": { "type": "array" },
        "deferredScope": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "x-variantRequirements": {
    "draft": {
      "status": "draft",
      "nonEmpty": []
    },
    "finalized": {
      "status": "finalized",
      "nonEmpty": [
        "ideaId",
        "projectType",
        "product.problemStatement",
        "product.solutionSummary",
        "governance.topRisks",
        "artifacts.sessionFiles",
        "artifacts.adrReferences"
      ],
      "existingArtifactReferences": [
        "artifacts.summaryExport",
        "artifacts.adrReferences"
      ]
    }
  }
}
