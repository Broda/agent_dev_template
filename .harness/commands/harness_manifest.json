{
  "schemaVersion": 2,
  "harnessVersion": "0.2.0",
  "templateRepository": "https://github.com/Broda/agent_dev_template",
  "sourceCommit": "template-source",
  "sourceCommitType": "template",
  "sourceWorktreeDirty": false,
  "compatibility": {
    "wrapperRuntimeVersion": 1,
    "capabilityVersion": 2,
    "stateSchemaVersion": 2,
    "stateSchemaPath": ".harness/schemas/project-init.schema.v2.json"
  },
  "supportedModes": [
    "brainstorming",
    "development"
  ],
  "stableWrappers": [
    {
      "path": "scripts/lab",
      "backendCommand": "lab-<command>"
    },
    {
      "path": "scripts/finalize-project",
      "backendCommand": "finalize-project"
    },
    {
      "path": "scripts/harness-release-check",
      "backendCommand": "harness-release-check"
    },
    {
      "path": "scripts/validate-governance",
      "backendCommand": "validate-governance"
    },
    {
      "path": "scripts/project-harness",
      "backendCommand": "project-harness-new | project-harness-update | project-harness-validate"
    },
    {
      "path": "scripts/render-intent-docs",
      "backendCommand": "render-intent-docs"
    },
    {
      "path": "scripts/sync-plugin-skills",
      "backendCommand": "sync-plugin-skills"
    }
  ],
  "posixExecutablePaths": [
    "scripts/finalize-project",
    "scripts/finalize-project.sh",
    "scripts/harness-release-check",
    "scripts/harness-release-check.sh",
    "scripts/lab",
    "scripts/lab-note",
    "scripts/lab-note.sh",
    "scripts/lab-sync",
    "scripts/lab-sync.sh",
    "scripts/lab.sh",
    "scripts/project-harness",
    "scripts/project-harness.sh",
    "scripts/render-development-docs",
    "scripts/render-development-docs.sh",
    "scripts/render-intent-docs",
    "scripts/render-intent-docs.sh",
    "scripts/sync-plugin-skills",
    "scripts/sync-plugin-skills.sh",
    "scripts/validate-brainstorming",
    "scripts/validate-brainstorming.sh",
    "scripts/validate-development",
    "scripts/validate-development.sh",
    "scripts/validate-governance",
    "scripts/validate-governance.sh"
  ],
  "artifactInventory": {
    "harnessOwned": [
      "AGENTS.md",
      ".harness/docs/BOOTSTRAP_TOOL.md",
      ".harness/docs/HARNESS_IMPROVEMENT_ROADMAP.md",
      ".harness/commands/finalization_overwrite_policy.json",
      ".harness/commands/harness_manifest.schema.json",
      ".harness/commands/intent_registry.schema.json",
      ".harness/commands/intent_registry.json",
      ".harness/brainstorming/",
      ".harness/development/",
      ".harness/docs/",
      ".harness/runtime/python/template_cli/",
      ".harness/schemas/",
      ".harness/tests/",
      ".harness/history/exports/.gitkeep",
      "scripts/finalize-project",
      "scripts/finalize-project.ps1",
      "scripts/finalize-project.sh",
      "scripts/harness-release-check",
      "scripts/harness-release-check.ps1",
      "scripts/harness-release-check.sh",
      "scripts/lab",
      "scripts/lab.ps1",
      "scripts/lab.sh",
      "scripts/lab-note",
      "scripts/lab-note.ps1",
      "scripts/lab-note.sh",
      "scripts/lab-sync",
      "scripts/lab-sync.ps1",
      "scripts/lab-sync.sh",
      "scripts/project-harness",
      "scripts/project-harness.ps1",
      "scripts/project-harness.sh",
      "scripts/render-development-docs",
      "scripts/render-development-docs.ps1",
      "scripts/render-development-docs.sh",
      "scripts/render-intent-docs",
      "scripts/render-intent-docs.ps1",
      "scripts/render-intent-docs.sh",
      "scripts/sync-plugin-skills",
      "scripts/sync-plugin-skills.ps1",
      "scripts/sync-plugin-skills.sh",
      "scripts/validate-brainstorming",
      "scripts/validate-brainstorming.ps1",
      "scripts/validate-brainstorming.sh",
      "scripts/validate-development",
      "scripts/validate-development.ps1",
      "scripts/validate-development.sh",
      "scripts/validate-governance",
      "scripts/validate-governance.ps1",
      "scripts/validate-governance.sh",
      ".agents/skills/",
      ".harness/plugins/project-lifecycle-lab/"
    ],
    "projectOwned": [
      "ideas/",
      "sessions/",
      "notes/",
      "exports/",
      "state/project-init.json",
      "scripts/project_harness_validation.py",
      "docs/",
      "src/",
      "tests/"
    ],
    "mixedGenerated": [
      "README.md",
      "CHANGELOG.md",
      ".gitignore",
      "MODE.md",
      ".harness/commands/harness_manifest.json",
      ".harness/commands/COMMANDS.md",
      ".harness/commands/CONVERSATIONAL_MODE.md"
    ],
    "archival": [
      "NOTES_CATALOG.md",
      "IDEA_CATALOG.md",
      ".harness/history/"
    ]
  },
  "artifactInventoryExclusions": [
    ".editorconfig",
    ".gitattributes",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/workflows/ci.yml",
    ".github/workflows/governance-audit.yml",
    ".github/workflows/release-readiness.yml",
    ".agents/plugins/marketplace.json",
    "LICENSE",
    "pyproject.toml",
    "requirements-dev.txt"
  ],
  "artifactInventorySnapshotPolicy": {
    "decision": "keep-broad-directory-entries",
    "snapshotGeneration": "deferred",
    "rationale": "Broad entries remain only where the whole directory has one ownership class. Command wrappers use exact harness-owned paths over the project-owned scripts boundary, and history uses an archival boundary with one exact harness-owned sentinel.",
    "broadEntries": [
      ".agents/skills/",
      ".harness/brainstorming/",
      ".harness/development/",
      ".harness/docs/",
      "docs/",
      "docs/adr/",
      "exports/",
      "ideas/",
      "notes/",
      ".harness/runtime/python/template_cli/",
      ".harness/schemas/",
      ".harness/plugins/project-lifecycle-lab/",
      ".harness/tests/",
      ".harness/history/",
      "sessions/",
      "src/",
      "tests/"
    ]
  }
}
